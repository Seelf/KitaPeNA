# Kitapena Environment Configuration Template
# Copy this file to .env and fill in the actual values

# Flask Settings
# Set to 'development' for auto-reload and debug mode
# Set to 'production' for performance and 4 workers (auto-reload disabled)
FLASK_ENV=development
SECRET_KEY=generate_a_very_long_random_string_here
PORT=5002

# PostgreSQL Configuration
POSTGRES_USER=kitapena_admin
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=kitapena_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Security (Cloudflare Turnstile)
# Get these from Cloudflare Dashboard
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
