# Security Configuration
# Generate a strong random key: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change_me_to_a_long_random_string

# Flask Environemnt
# production = Secure cookies, HSTS headers, no debug
# development = Debug mode allowed (if FLASK_DEBUG=true)
FLASK_ENV=production

# Debug Mode (set to 'false' in production)
FLASK_DEBUG=false

# Server Port
PORT=5002

# Cloudflare Turnstile (Optional - for Login page CAPTCHA)
# Get these from Cloudflare Dashboard
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
